{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "clippy",
  "version": "1.7.0",
  "identifier": "com.clippy.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": { 
    "windows": [
      {
        "title": "clippy",
        "fullscreen": false,
        "width": 320,
        "height": 640,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
